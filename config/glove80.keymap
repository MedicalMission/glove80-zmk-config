        };
        /* US = / + (Shift) */
        us_equal: us_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(N0)>, <&kp RBKT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        /* US [ / { (Shift) */
        us_lbkt: us_lbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RA(N8)>, <&kp RA(N7)>;
