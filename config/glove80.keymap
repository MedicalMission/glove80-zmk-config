/ {
    macros {
        us_caret: us_caret_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE>, <&kp SPACE>; // German ^ is a dead key
        };
        /* US backtick ` (German dead-key + Space) */
        us_grave_macro: us_grave_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(EQUAL)>, <&kp SPACE>; // German grave is a dead key
        };
    };
    behaviors {
        /* US 2 / @ (Shift) */
        us_n2: us_n2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
