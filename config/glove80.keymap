/* Automatically generated behavior definitions */
/ {
    behaviors {

        /* left-hand hold activates layer; tap sends key */

        HT_MO_L: HT_MO_L {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <140>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <28 16 5 17 18 6 7 19 31 29 30 42 41 40 58 59 61 60 76 75 77 43 44 32 20 8 9 21 33 45 63 62 78 79 57 56 55 72 73 74>;
        };

        /* hold sends first key; tap sends second key */

        CTRL: CTRL {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            quick-tap-ms = <0>;
            hold-trigger-key-positions = <>;
        };

        /* left-hand hold sends modifier; tap sends key */

        HT_KP_L: HT_KP_L {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <190>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <120>;
            hold-trigger-key-positions = <28 16 5 17 18 6 7 19 31 29 30 42 41 40 58 59 61 60 76 75 77 43 44 32 20 8 9 21 33 45 63 62 78 79 57 56 55 72 73 74>;
        };

        /* right-hand hold activates layer; tap sends key */

        HT_MO_R: HT_MO_R {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <140>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <1 11 10 0 23 22 34 35 46 47 65 64 66 48 36 24 12 2 3 13 4 14 15 27 26 25 37 38 39 51 50 49 67 68 52 69 70 53 54 71>;
        };

        /* right-hand hold sends modifier; tap sends key */

        HT_KP_R: HT_KP_R {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <190>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <120>;
            hold-trigger-key-positions = <0 1 11 10 23 22 34 35 46 64 65 47 66 36 48 24 12 2 3 4 14 13 25 26 38 37 49 68 67 50 51 39 27 15 52 69 70 53 54 71>;
        };

        /* 350 ms hold/tap: hold first keycode, tap second */

        umlaut: umlaut {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <350>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <300>;
            hold-trigger-key-positions = <>;
        };
    };
};

